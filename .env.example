# Railway Postgres
DATABASE_URL=

# "mock" (sandbox, no real money) or "live" (Solana mainnet + Paj)
PAYMENT_MODE=mock

# Solana mainnet RPC + escrow hot wallet (generate: node scripts/keygen.mjs)
SOLANA_RPC_URL=
ESCROW_SECRET_KEY=

# Public URL of this deployment (for Paj webhooks), e.g. https://kobolt.up.railway.app
PUBLIC_URL=

# Gate for the whole app (real money!). Portfolio pages stay public.
APP_PASSCODE=

# HMAC key for the audit log signatures
AUDIT_SECRET=

# Verifier LLM (OpenAI-compatible). Swap LLM_BASE_URL/LLM_MODEL to the Adaption-adapted model when ready.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash

# Agent delegate key (separate from owner/treasury)
AGENT_SECRET_KEY=
VERIFIER_SAMPLES=5
# Treat non-TikTok links as fetched (labelled "mock") for demo
DEMO_MOCK_FETCH=1
# Optional: Adaption-adapted model endpoint (OpenAI-compatible)
ADAPTED_BASE_URL=
ADAPTED_API_KEY=
ADAPTED_MODEL=

# Notifications (Resend). Without a verified domain use onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=Kobolt <onboarding@resend.dev>
